package ScrewDetection import Screwdetection::* import Adaptation::* import Types::* module ScrewDetection {
	connection ctrl_ref0 on imageTaken to ctrl_ref1 on imageTaken ( _async )
	connection ctrl_ref0 on modelChanged to ctrl_ref1 on modelChanged ( _async )
	connection ctrl_ref1 on newPlan to ctrl_ref0 on newPlan ( _async )
	cref ctrl_ref0 = ScrewDetection
	cref ctrl_ref1 = Adaptation
	robotic platform UR5WithCamera {
		uses Camera uses ArmSensors provides Movement provides Gripper }

}

