package Adaptation import ScrewDetection::* import Adaptation_Execute::* import Adaptation_Plan::* import Adaptation_Monitor::* import Adaptation_Legitimate::* import Adaptation_Knowledge::* import Adaptation_Analyse::* import Types::* controller Adaptation {
	event imageTaken : ScrewImageData
	event modelChanged : VisionModel
	event newPlan : AdaptationPlan
	sref stm_ref4 = Adaptation_Execute
	sref stm_ref5 = Adaptation_Knowledge
	sref stm_ref3 = Adaptation_Legitimate
	sref stm_ref0 = Adaptation_Monitor
	sref stm_ref2 = Adaptation_Plan
