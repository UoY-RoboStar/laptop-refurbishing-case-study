	connection stm_ref5 on averageUncertainty_Legitimate to stm_ref3 on averageUncertainty
	connection stm_ref3 on get_proposedPlan to stm_ref5 on get_proposedPlan_Legitimate
	connection stm_ref0 on set_currentModel to stm_ref5 on set_currentModel
	connection Adaptation on imageTaken to stm_ref0 on imageTaken
	connection stm_ref5 on images_Legitimate to stm_ref3 on images
	connection stm_ref4 on newPlan to Adaptation on newPlan
	connection stm_ref5 on averageUncertainty_Plan to stm_ref2 on averageUncertainty
	connection stm_ref5 on proposedPlan_Execute to stm_ref4 on proposedPlan
	connection stm_ref4 on get_estimatedLight to stm_ref5 on get_estimatedLight_Execute
	connection stm_ref5 on images_Plan to stm_ref2 on images
	connection stm_ref3 on get_triedThirdModel to stm_ref5 on get_triedThirdModel_Legitimate
	connection stm_ref0 on get_currentModel to stm_ref5 on get_currentModel
	connection stm_ref1 on anomalyFound to stm_ref2 on requestPlan
	connection stm_ref0 on set_images to stm_ref5 on set_images
	connection stm_ref2 on get_proposedPlan to stm_ref5 on get_proposedPlan
	connection stm_ref5 on estimatedLight_Execute to stm_ref4 on estimatedLight
	connection stm_ref3 on set_newAverageUncertainty to stm_ref5 on set_newAverageUncertainty
	connection stm_ref5 on averageUncertainty to stm_ref1 on averageUncertainty
	connection stm_ref2 on get_newPosition to stm_ref5 on get_newPosition_Plan
	connection stm_ref3 on get_newPosition to stm_ref5 on get_newPosition
	connection stm_ref5 on currentModel_Plan to stm_ref2 on currentModel
	connection stm_ref1 on get_currentModel to stm_ref5 on get_currentModel_Analyse
	connection stm_ref1 on get_images to stm_ref5 on get_images_Analyse
	connection stm_ref5 on currentModel_Legitimate to stm_ref3 on currentModel
	connection stm_ref5 on triedThirdModel_Execute to stm_ref4 on triedThirdModel
	connection stm_ref2 on set_triedThirdModel to stm_ref5 on set_triedThirdModel
	connection stm_ref2 on get_currentModel to stm_ref5 on get_currentModel_Plan
	connection stm_ref2 on get_triedThirdModel to stm_ref5 on get_triedThirdModel
	connection stm_ref5 on proposedPlan_Legitimate to stm_ref3 on proposedPlan
	connection stm_ref3 on get_newAverageUncertainty to stm_ref5 on get_newAverageUncertainty
	connection stm_ref3 on planRejected to stm_ref2 on planRejected
	connection stm_ref4 on get_proposedPlan to stm_ref5 on get_proposedPlan_Execute
	connection stm_ref5 on proposedPlan to stm_ref2 on proposedPlan
	connection stm_ref0 on processedData to stm_ref1 on processedData
	connection stm_ref5 on images to stm_ref0 on images
	connection stm_ref1 on get_averageUncertainty to stm_ref5 on get_averageUncertainty
	connection stm_ref2 on get_images to stm_ref5 on get_images_Plan
	connection stm_ref5 on newPosition to stm_ref3 on newPosition
