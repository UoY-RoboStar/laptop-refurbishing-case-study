system ScrewDetection

//////////////////////
// Robotic Platform //
//////////////////////
interface Movement {
	move(position : real * real * real, orientation : real * real * real)
}

interface Gripper {
	grip()
	release()
	activateTool()
	deactivateTool()
}

// an image taken by the camera, with RGB values for each pixel
datatype ImageData {
	pixels : Seq(Seq(nat*nat*nat))
	height : nat
	width : nat
}

interface Camera {
	event getImage : ImageData
}

interface ArmSensors {
	event forceTorque : (real * real * real) * (real * real * real)
	event positionOrientation : (real * real * real) * (real * real * real)
}

robotic platform UR5WithCamera {
	provides Movement
	provides Gripper
	uses Camera
	uses ArmSensors
}

////////////////////
// Managed System //
////////////////////

// the three vision models that the system can use, trained on different lighting conditions
enumeration VisionModel {
	DimModel
	NormalModel
	BrightModel
}

// identifies the position of an object in an image and the confidence of its detection
datatype EstimatedPosition {
	// topLeft and bottomRight use nat because they index pixels in a sequence
	topLeft : nat * nat
	bottomRight : nat * nat
	uncertainty : real
}

// an image taken by the camera with metadata about the position and orientation
// it was taken from, and the estimated positions of any screws detected
datatype ScrewImageData {
	position : real * real * real
	orientation : real * real * real
	image : ImageData
	screwsDetected : Seq(EstimatedPosition)
}

layer ScrewDetection : ControlLayer {
	requires Movement
	uses ArmSensors
	uses Camera
	
	outputs = imageTaken : ScrewImageData, modelChanged : VisionModel;
	inputs = newPlan : AdaptationPlan;
	
};

///////////////////
// MAPLE-K layer //
///////////////////

enumeration AdaptationPlan {
	NewModel(VisionModel)
	MoveDown
	StopRobot
}

layer Adaptation : PlanningLayer {
	inputs = imageTaken : ScrewImageData, modelChanged : VisionModel;
	outputs = newPlan : AdaptationPlan;
	
	pattern = MAPLE-K;
	
	monitor {
		// record the images that have been taken and ambient light levels, pass to analyse when new image comes in
		inputs = imageTaken, modelChanged;
		processed_data_type = ScrewImageData;
		recorded_data = images : Seq(ScrewImageData);
		recorded_data = currentModel : nat;
	}
	analyse {
		// compute average uncertainty and check against threshold
		analysis_results = averageUncertainty : nat;
	}
	plan {
		// estimate light level, pick new model that works best for that light level,
		// if plan rejected (proposedPlan == NewModel, triedThirdModel == false), try a third model
		// if plan still rejected (proposedPlan == NewModel, triedThirdModel == true), suggest moving down
		// if plan still rejected (proposedPlan == MoveDown), order robot to stop
		plan_data = estimatedLight : real;
		plan_data = proposedPlan : AdaptationPlan;
		plan_data = triedThirdModel : boolean;
	}
	legitimate {
		// if the plan is to change model, recheck the images using the new model, check the new average uncertainty against the threshold
		// if the plan is to move down, compute the new position and check for a collision
		// if the plan is to stop, accept it unconditionally (this should always be safe)
		verification_info = newAverageUncertainty : real;
		verification_info = newPosition : real * real * real;
	}
	execute {
		// send the new plan for the managed system to act on, then signal the adaptation as complete
		outputs = newPlan;
	}
};

/////////////////
// Connections //
/////////////////

connections =
	ScrewDetection on imageTaken to Adaptation on imageTaken,
	ScrewDetection on modelChanged to Adaptation on modelChanged,
	Adaptation on newPlan to ScrewDetection on newPlan;
	